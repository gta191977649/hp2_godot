[configuration]
entry_symbol = "ps2_port_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://bin/ps2_port.dll"
windows.release.x86_64 = "res://bin/ps2_port.dll"
linux.debug.x86_64 = "res://bin/ps2_port.so"
linux.release.x86_64 = "res://bin/ps2_port.so"

macos.debug = "res://bin/ps2_port.dylib"
macos.release = "res://bin/ps2_port.dylib"

[dependencies]
windows.x86_64 = {
"res://bin/avcodec-62.dll": "",
"res://bin/avutil-60.dll": "",
"res://bin/swscale-9.dll": "",
"res://bin/swresample-6.dll": ""
}
