; TASK-0016 runtime front-end entry and per-platform RenderingDevice defaults.
config_version=5

[application]
config/name="HP2 PS2 Native Port"
run/main_scene="res://scenes/frontend_native.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
; PORT-SIDE. User-requested: show the engine boot splash while the host loads, before the
; game's own EA/NFS intro sequence begins. The image is Godot's built-in logo (no
; boot_splash/image key), so nothing is added to the repository, and the background is the
; same black the rest of the host uses. This is host presentation; it has no original-game
; counterpart and must not be read as recovered behaviour.
boot_splash/show_image=true
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]
Ps2RenderContract="*res://scripts/runtime/render_contract.gd"
UiDisplay="*res://scripts/runtime/ui_display.gd"
DebugTools="*res://scripts/debug/debug_tools.gd"
ProfileDebug="*res://scripts/debug/profile_debug.gd"

[input]
; TASK-0046 port-side driving bindings, shared by keyboard/gamepad/GUI adapter.
hp2_drive_throttle={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
hp2_drive_brake={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
hp2_drive_left={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
hp2_drive_right={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
hp2_drive_handbrake={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
hp2_drive_shift_down={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
hp2_drive_shift_up={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
; TASK0082 port-side keyboard binding; original honk behavior remains native.
hp2_drive_horn={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

; TASK0088 port-side binding for the original available driving POV cycle.
hp2_drive_camera_view={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":86)]
}

; TASK0088 port-side hold binding for original JOY_EVENT_CAMERA_LOOKBACK.
hp2_drive_camera_lookback={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":66)]
}

hp2_drive_release_cursor={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]
; TASK-0016 user-requested host backdrop for uncovered movie/title pixels.
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
; TASK-0071: numeric GS RGB uses explicit HDR offscreen transport, not PBR colour.
renderer/rendering_method="forward_plus"
; TASK0072: preserve Safe until independent threaded validation passes.
driver/threads/thread_model=1
rendering_device/driver.windows="vulkan"
rendering_device/driver.macos="metal"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=false
anti_aliasing/screen_space_roughness_limiter/enabled=false

[hp2]
; TASK0055 host-only policy: accepted visual/performance gates; original effects/LOD unchanged.
rendering/optimization_profile="optimized"
; TASK0072: exact previous-count GPU transport; CPU reference remains selectable.
rendering/sun_gpu_resident=true

; TASK0085: optional GPU backend; native remains default until measured gates pass.
rendering/particle_backend="native"
