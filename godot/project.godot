; TASK-0016 runtime front-end entry and per-platform RenderingDevice defaults.
config_version=5

[application]
config/name="HP2 PS2 Native Port"
run/main_scene="res://scenes/frontend_native.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
; PORT-SIDE. User-requested: show the engine boot splash while the host loads, before the
; game's own EA/NFS intro sequence begins. The image is Godot's built-in logo (no
; boot_splash/image key), so nothing is added to the repository, and the background is the
; same black the rest of the host uses. This is host presentation; it has no original-game
; counterpart and must not be read as recovered behaviour.
boot_splash/show_image=true
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]
DebugTools="*res://scripts/debug/debug_tools.gd"

[input]
; TASK-0046 port-side driving bindings, shared by keyboard/gamepad/GUI adapter.
hp2_drive_throttle={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
hp2_drive_brake={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
hp2_drive_left={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
hp2_drive_right={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
hp2_drive_handbrake={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
hp2_drive_shift_down={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
hp2_drive_shift_up={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

hp2_drive_release_cursor={
"deadzone": 0.1,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]
; TASK-0016 user-requested host backdrop for uncovered movie/title pixels.
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
; TASK-0033: encoded framebuffer RGB is required by the recovered GS blend equation.
renderer/rendering_method="gl_compatibility"
rendering_device/driver.windows="d3d12"
rendering_device/driver.macos="metal"
rendering_device/driver.linuxbsd="vulkan"
