static func group_for(widget: Dictionary, shared_scene: bool) -> String:
	if shared_scene or str(widget.id).begins_with("event") or int(widget.stack)>0: return "scene"
	var parts: PackedStringArray = str(widget.id).split(":")
	if parts.size()!=2 or not parts[1].is_valid_int(): return "body"
	var groups: Dictionary = DOCUMENTS.get(parts[0], {})
	for group in groups:
		if int(parts[1]) in groups[group]: return group
	return "scene"
