{
  "version": 5,
  "configurePresets": [
    {
      "name": "godot-mvp-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/godot-mvp-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "godot-mvp-release",
      "inherits": "godot-mvp-debug",
      "binaryDir": "${sourceDir}/build/godot-mvp-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "godot-mvp-debug", "configurePreset": "godot-mvp-debug" },
    { "name": "godot-mvp-release", "configurePreset": "godot-mvp-release" }
  ]
}
