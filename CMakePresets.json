{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "PORT_BUILD_GODOT": "OFF"
      }
    },
    {
      "name": "godot-debug",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/build/godot-debug",
      "cacheVariables": {
        "PORT_BUILD_GODOT": "ON"
      }
    },
    {
      "name": "godot-release",
      "inherits": "godot-debug",
      "binaryDir": "${sourceDir}/build/godot-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "godot-debug",
      "configurePreset": "godot-debug"
    },
    {
      "name": "godot-release",
      "configurePreset": "godot-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "godot-debug",
      "configurePreset": "godot-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
