[rendering]

rendering_device/driver.windows="vulkan"
driver/depth_prepass/enable=false
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

hp2_animation_clock={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hp2_roadshine={
"type": "bool",
"value": true
}
hp2_track_focal_scale={
"type": "float",
"value": 209.06665
}
