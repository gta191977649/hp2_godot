config_version=5

[application]
config/name="HP2 Entities Bridge"
config/use_custom_user_dir=true
config/custom_user_dir_name="HP2 Entities Bridge"
run/main_loop_type="SceneTree"
run/main_scene="res://native_game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[input]

hp2_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":4194308)]
}

hp2_quit={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

hp2_menu_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194308)]
}

hp2_menu_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":4194310)]
}

hp2_menu_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194320), Object(InputEventKey,"physical_keycode":87)]
}

